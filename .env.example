# Secrets — copy to .env (never commit .env):
#   copy .env.example .env

# --- xAI (required for daily generation) ---
# https://console.x.ai/
XAI_API_KEY=

# Chat model for GTM research + literary/painting planning (Grok).
# grok-4.3 is the current short-context planner. It defaults to low reasoning.
XAI_CHAT_MODEL=grok-4.3

# Image model for literary + painting wallpapers.
# grok-imagine-image is $0.02. The newer grok-imagine-image-2.0 is $0.04.
XAI_IMAGE_MODEL=grok-imagine-image

# Optional cost estimate rates (USD). Defaults in rotator/costs.py match
# grok-4.3 (below 200k tokens) and grok-imagine-image as of 2026-11-08.
# XAI_PRICE_CHAT_INPUT_PER_MTOK=1.25
# XAI_PRICE_CHAT_OUTPUT_PER_MTOK=2.50
# XAI_PRICE_IMAGE_USD=0.02

# --- NASA APOD (reject fallback + curated) ---
# https://api.nasa.gov/
NASA_API_KEY=

# --- Pexels (optional curated photos) ---
# PEXELS_API_KEY=
