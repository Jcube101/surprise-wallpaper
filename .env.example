# Secrets — copy to .env (never commit .env):
#   copy .env.example .env

# --- xAI (required for daily generation) ---
# https://console.x.ai/
XAI_API_KEY=

# Chat model for GTM research + literary/painting planning (Grok)
# Examples: grok-4-1-fast-reasoning, grok-4, grok-3
XAI_CHAT_MODEL=grok-4-1-fast-reasoning

# Image model for literary + painting wallpapers
# Examples: grok-imagine-image, grok-imagine-image-quality
XAI_IMAGE_MODEL=grok-imagine-image

# Optional cost estimate rates (USD) — adjust to your plan
# XAI_PRICE_CHAT_INPUT_PER_MTOK=3.0
# XAI_PRICE_CHAT_OUTPUT_PER_MTOK=15.0
# XAI_PRICE_IMAGE_USD=0.07

# --- NASA APOD (reject fallback + curated) ---
# https://api.nasa.gov/
NASA_API_KEY=

# --- Pexels (optional curated photos) ---
# PEXELS_API_KEY=
